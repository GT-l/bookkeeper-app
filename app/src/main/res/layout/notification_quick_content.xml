<?xml version="1.0" encoding="utf-8"?>
<!-- 常驻通知专用布局：内容由 AutoCaptureForegroundService 用 RemoteViews 填充，
     每一项是否显示由用户在「通知栏显示内容」页自行选择。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nf_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/nf_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auto_capture_notification_title"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nf_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/nf_month"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/nf_budget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/nf_last"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/nf_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/nf_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nf_quick_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingEnd="16dp"
            android:text="@string/quick_add"
            android:textColor="#C74372"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nf_ball_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="显示/隐藏悬浮球"
            android:textColor="#C74372"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
