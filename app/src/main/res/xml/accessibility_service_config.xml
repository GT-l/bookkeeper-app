<?xml version="1.0" encoding="utf-8"?>
<!--
  无障碍服务能力声明。

  v1.3.12 重要变更：恢复 android:canTakeScreenshot="true"。

  v1.2.3 曾为了「降低侧载风控触发面」移除该能力，结果是：
  微信账单详情这类自绘 / WebView 页面读不到任何节点文本时，
  无障碍截屏与媒体投影**两条通道同时不可用**，摇一摇直接失败
  （用户 realme RMX3888 / Android 37 的真实日志：
   「读屏节点：当前页面没有可读文本」+「两条截屏通道都不可用」）。

  现在恢复该能力：
  - 无障碍截屏不需要录屏授权、不受 Android 14+ 「重启后会话失效」限制；
  - 若某 ROM 上 takeScreenshot 触发 native 崩溃，CaptureBreakerStore 的
    in-flight 标记会在下次启动自动熔断该通道，不会反复闪退（两层保护）。

  仍然保留的最小权限取舍：
  - 不声明 packageNames：事件过滤在 PaymentAccessibilityService.dispatchEvent 里
    用 Constants.PAYMENT_PACKAGES 完成，避免向系统明示「监听支付 App」。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowContentChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagIncludeNotImportantViews|flagRequestFingerprintGestures"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="150"
    android:settingsActivity="com.azu.bookkeeper.MainActivity" />
