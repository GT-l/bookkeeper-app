<?xml version="1.0" encoding="utf-8"?>
<!-- 隐私优先：账单数据库与加密文件不参与系统自动备份，仅使用应用内加密备份功能 -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="root" path="files/" />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
